VITE_USE_MOCKS=true
VITE_API_BASE_URL=/api/v1
VITE_MOCK_LATENCY_MS=250
VITE_MOCK_ERROR_RATE=0

# --- AI gateway + chatbot backend (server/, run with `npm run gateway`) ---
# Copy this file to .env (git-ignored). These variables are read by the server only; Vite never exposes them to the browser.
# Never commit real keys.

# Provider API keys. Optional: a key saved in AI Settings overrides these for that user.
# GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

# Optional embeddings for chatbot retrieval. Used automatically when an OpenAI or Gemini key is available
# (Groq and Anthropic have no embedding API); otherwise retrieval is keyword-only.
# EMBEDDING_MODEL_OPENAI=text-embedding-3-small
# EMBEDDING_MODEL_GEMINI=gemini-embedding-001

# GATEWAY_PORT=8787
# GATEWAY_TIMEOUT_MS=60000
# GATEWAY_DATA_DIR=server/.data
# 32-byte key (64 hex chars or base64) that encrypts keys saved in AI Settings. If unset, a local key file is
# generated in server/.data (demo only). Set it explicitly outside local demos.
# GATEWAY_MASTER_KEY=
